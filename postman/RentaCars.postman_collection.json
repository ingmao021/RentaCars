    {
      "name": "03 - Flujo de Alquileres y Relaciones (Rentals)",
      "description": "Pruebas integrales de relaciones: vinculación de User y Car en Rental, actualización reactiva de disponibilidad del carro y control de estados.",
      "item": [
        {
          "name": "1. Crear Alquiler (Relaciona User y Car)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const end = new Date(now.getTime() + 5 * 24 * 60 * 60 * 1000);",
                  "pm.variables.set(\"rentalStartDate\", now.toISOString());",
                  "pm.variables.set(\"rentalEndDate\", end.toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Alquiler creado con relaciones pobladas (user, profile, car)\", function () {",
                  "    pm.expect(res).to.have.property(\"id\");",
                  "    pm.expect(res).to.have.property(\"user\");",
                  "    pm.expect(res.user).to.have.property(\"profile\");",
                  "    pm.expect(res).to.have.property(\"car\");",
                  "    pm.expect(res.car.id).to.eql(parseInt(pm.collectionVariables.get(\"carId\")));",
                  "    pm.expect(res.user.id).to.eql(parseInt(pm.collectionVariables.get(\"userId\")));",
                  "    pm.expect(res.isActive).to.be.true;",
                  "});",
                  "",
                  "if (res.id) {",
                  "    pm.collectionVariables.set(\"rentalId\", res.id);",
                  "    console.log(\"rentalId guardado:\", res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"carId\": {{carId}},\n  \"startDate\": \"{{rentalStartDate}}\",\n  \"endDate\": \"{{rentalEndDate}}\",\n  \"notes\": \"Alquiler de prueba para verificar relaciones completas\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rentals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rentals"
              ]
            }
          }
        },
        {
          "name": "2. Verificar Carro Ocupado (isAvailable cambia a false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"El carro ahora está no disponible (isAvailable: false)\", function () {",
                  "    pm.expect(res.isAvailable).to.be.false;",
                  "});",
                  "",
                  "pm.test(\"El carro incluye en sus relaciones el alquiler activo\", function () {",
                  "    pm.expect(res.rentals).to.be.an(\"array\");",
                  "    const rental = res.rentals.find(r => r.id === parseInt(pm.collectionVariables.get(\"rentalId\")));",
                  "    pm.expect(rental).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cars/{{carId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cars",
                "{{carId}}"
              ]
            }
          }
        },
        {
          "name": "3. Verificar Usuario con Relación a Rental y Car",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"El usuario lista su alquiler y los datos del carro relacionado\", function () {",
                  "    pm.expect(res.rentals).to.be.an(\"array\");",
                  "    pm.expect(res.rentals.length).to.be.greaterThan(0);",
                  "    const rental = res.rentals.find(r => r.id === parseInt(pm.collectionVariables.get(\"rentalId\")));",
                  "    pm.expect(rental).to.not.be.undefined;",
                  "    pm.expect(rental).to.have.property(\"car\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
