          }
        },
        {
          "name": "4. Intentar Alquilar Carro Ocupado (Validación 400 Bad Request)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const end = new Date(now.getTime() + 3 * 24 * 60 * 60 * 1000);",
                  "pm.variables.set(\"overlapStartDate\", now.toISOString());",
                  "pm.variables.set(\"overlapEndDate\", end.toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Error confirma que el carro no está disponible\", function () {",
                  "    pm.expect(res.message).to.include(\"no está disponible\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"carId\": {{carId}},\n  \"startDate\": \"{{overlapStartDate}}\",\n  \"endDate\": \"{{overlapEndDate}}\",\n  \"notes\": \"Intento no permitido\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rentals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rentals"
              ]
            }
          }
