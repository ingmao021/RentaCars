      "name": "01 - Usuarios y Perfiles (Relación 1:1)",
      "description": "Operaciones CRUD para usuarios con perfil anidado (One-to-One).",
      "item": [
        {
          "name": "1. Crear Usuario con Perfil",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Usuario creado con perfil anidado (1:1)\", function () {",
                  "    pm.expect(res).to.have.property(\"data\");",
                  "    pm.expect(res.data).to.have.property(\"id\");",
                  "    pm.expect(res.data).to.have.property(\"email\");",
                  "    pm.expect(res.data).to.have.property(\"profile\");",
                  "    pm.expect(res.data.profile).to.have.property(\"driverLicense\");",
                  "});",
                  "",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set(\"userId\", res.data.id);",
                  "    console.log(\"userId guardado:\", res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario_{{$randomInt}}@rentacars.com\",\n  \"profile\": {\n    \"firstName\": \"Sebastian\",\n    \"lastName\": \"Ibarra\",\n    \"phone\": \"+573123456789\",\n    \"driverLicense\": \"DL-COL-{{$randomInt}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
