                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test(\"Retorna lista con conteo y perfiles poblados\", function () {",
                  "    pm.expect(res).to.have.property(\"data\");",
                  "    pm.expect(Array.isArray(res.data)).to.be.true;",
                  "    if (res.data.length > 0) {",
                  "        pm.expect(res.data[0]).to.have.property(\"profile\");",
